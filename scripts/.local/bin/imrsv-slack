#!/bin/zsh
# Control the IMRSV Slack bot service on Jean-1 (launchd label com.imrsv.slack).
# On Jean-1 the commands run directly; on any other machine they run over ssh.
# Run `imrsv-slack help` for the list. Runbook: jean-manor/docs/services.md.

set -u
LABEL="com.imrsv.slack"
PLIST="/Library/LaunchDaemons/$LABEL.plist"
JEAN="admin@jean-1"
BUILD_DIR="$HOME/repos/IMRSV/imrsv-slack"

on_jean() { [[ "$(hostname -s)" == jean-1 ]]; }

# Run a shell command line on Jean-1. $HOME in it is expanded on Jean-1.
run() {
  local cmd="$1"
  if on_jean; then
    eval "$cmd"
  elif [[ "$cmd" == *sudo* ]]; then
    ssh -t "$JEAN" "$cmd"
  else
    ssh "$JEAN" "$cmd"
  fi
}

usage() {
  cat <<EOF
imrsv-slack <command>

Looking (safe any time, change nothing):
  status    state, pid, last exit, last log line. Run first when something seems off.
  log       last 20 log lines. Skim before pasting anywhere.
  follow    follow the log; Ctrl-C stops following, not the bot.
  pids      running copies. Healthy = 2 lines (doppler wrapper + java) = one bot.
            More than 2 lines means a stray copy: Slack splits commands between them.

Changing (the bot is down for a few seconds; Slack commands fail meanwhile):
  restart   after a deploy, or after changing a secret in Doppler (settings are read
            only at startup), or if the bot hangs. Not needed for anything else.
  start     only when it is stopped. Harmless if already running.
  stop      stops it until the next boot, then it comes back by itself. To keep it
            down for good, use 'off' as well.
  off       blocks the start at boot; does NOT stop a running bot (use 'stop').
            Easy to forget: until you run 'on', a reboot will not bring it back.
  on        allows the start at boot again; does NOT start it (use 'start').

Shipping:
  deploy    build machine only (needs Java 21, refuses on Jean-1). Runs the tests,
            builds, copies the WORKING TREE, committed or not, over ~/imrsv-slack on
            Jean-1 (--delete) and restarts. Make sure you are on the tested main.
            Stops at the first failing test. Asks for the admin sudo password.

  help      this list

Runs on Jean-1 directly, anywhere else over ssh to $JEAN. Commands with sudo ask for
the admin password.
EOF
}

cmd="${1:-help}"
case "$cmd" in
  status)
    run "launchctl print system/$LABEL | grep -E '^[[:space:]]+(state|pid|last exit code) ='; tail -n 1 \$HOME/Library/Logs/imrsv-slack.log"
    ;;
  log)     run "tail -n 20 \$HOME/Library/Logs/imrsv-slack.log" ;;
  follow)  run "tail -f \$HOME/Library/Logs/imrsv-slack.log" ;;
  pids)    run "pgrep -fl imrsv-slack | cut -c1-100" ;;
  restart) run "sudo launchctl kickstart -k system/$LABEL" ;;
  start)
    run "if launchctl print system/$LABEL >/dev/null 2>&1; then sudo launchctl kickstart system/$LABEL; else sudo launchctl bootstrap system $PLIST; fi"
    ;;
  stop)    run "sudo launchctl bootout system/$LABEL" ;;
  off)     run "sudo launchctl disable system/$LABEL" ;;
  on)      run "sudo launchctl enable system/$LABEL" ;;
  deploy)
    if on_jean; then
      echo "deploy builds the app, so run it on the build machine, not on Jean-1." >&2
      exit 1
    fi
    [[ -d "$BUILD_DIR" ]] || { echo "no checkout at $BUILD_DIR" >&2; exit 1; }
    cd "$BUILD_DIR" || exit 1
    ./gradlew test installDist || exit 1
    rsync -a --delete build/install/imrsv-slack/ "$JEAN:imrsv-slack/" || exit 1
    run "sudo launchctl kickstart -k system/$LABEL"
    ;;
  help|-h|--help) usage ;;
  *)
    echo "imrsv-slack: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
