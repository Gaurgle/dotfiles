theme = Catppuccin Mocha
# font-family = JetBrainsMono Nerd Font
font-family = MesloLGS Nerd Font
background-opacity = 0.99
font-size = 13
cursor-style = bar
window-padding-x = 10
window-padding-y = 6

# Keybindings

# tmux window selection: send prefix (C-a = \x01) + digit
keybind = cmd+digit_1=text:\x01\x31
keybind = cmd+digit_2=text:\x01\x32
keybind = cmd+digit_3=text:\x01\x33
keybind = cmd+digit_4=text:\x01\x34
keybind = cmd+digit_5=text:\x01\x35
keybind = cmd+digit_6=text:\x01\x36
keybind = cmd+digit_7=text:\x01\x37
keybind = cmd+digit_8=text:\x01\x38
keybind = cmd+digit_9=text:\x01\x39

# Tab selection (moved off cmd+digit for tmux)
keybind = cmd+opt+digit_1=goto_tab:1
keybind = cmd+opt+digit_2=goto_tab:2
keybind = cmd+opt+digit_3=goto_tab:3
keybind = cmd+opt+digit_4=goto_tab:4
keybind = cmd+opt+digit_5=goto_tab:5
keybind = cmd+opt+digit_6=goto_tab:6
keybind = cmd+opt+digit_7=goto_tab:7
keybind = cmd+opt+digit_8=goto_tab:8
keybind = cmd+opt+digit_9=goto_tab:9
keybind = option+backspace=text:\x17
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+9=move_tab:1
keybind = cmd+shift+8=move_tab:-1

# Commands

# Mouse
mouse-hide-while-typing = true

